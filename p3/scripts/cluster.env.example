# ============================================================================
#  CONFIGURACION DEL CLUSTER  -  Practica 3 (MPI)
# ============================================================================
#  1. Copia este fichero:
#         cp p3/scripts/cluster.env.example p3/scripts/cluster.env
#  2. Cambia AQUI las IPs (o nombres) de tus 3 PCs. Nada mas.
#  3. Ejecuta:  p3/scripts/cluster_setup.sh
#
#  El PRIMER nodo de NODES es el maestro: desde el se lanza "mpirun".
# ============================================================================

# --- IPs / hostnames de los PCs (minimo 3, todos en la misma red) -----------
NODES=(111.111.111.111 222.222.222.222 333.333.333.333)

# --- Usuario (debe existir con el mismo nombre en los 3 PCs) ----------------
SSH_USER="${USER}"

# --- Directorio de trabajo: ruta IDENTICA en los 3 PCs ----------------------
#    Si $HOME es compartido por NFS, basta con el repo clonado ahi.
WORKDIR="${HOME}/IC"

# --- Nucleos fisicos que se usan en cada PC ---------------------------------
#    Pon los nucleos fisicos reales (no los hilos de SMT).
SLOTS_PER_NODE=4

# --- Como se reparte el codigo entre los PCs -------------------------------
#    auto = detectarlo (recomendado)
#    nfs  = $HOME compartido, no se copia nada
#    copy = discos separados, se copia el repo + dataset MNIST por SSH
SYNC_MODE=auto

# --- Flags de Open MPI ------------------------------------------------------
#    plm_rsh_no_tree_spawn 1 = recomendado por la guia de la practica.
MPI_FLAGS="-mca plm_rsh_no_tree_spawn 1"

#    Reparto de rangos: "node" reparte round-robin entre PCs (necesario para
#    que con P < slots totales se usen de verdad los 3 PCs). "slot" llena el
#    primer PC antes de pasar al siguiente.
MAP_BY=node
BIND_TO=core

# --- Interfaz de red (opcional) ---------------------------------------------
#    Si mpirun elige la interfaz equivocada (p.ej. hay VPN o docker), pon aqui
#    el nombre de la interfaz del cluster: NET_IFACE=eth0  (o enp3s0, wlan0...)
NET_IFACE=""

# --- Donde se guardan los resultados del cluster ----------------------------
RESULTS_DIR="${WORKDIR}/p3/results/cluster"
