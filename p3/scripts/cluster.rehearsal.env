# ============================================================================
#  ENSAYO EN UN SOLO PC  -  valida toda la tuberia sin tocar el cluster
# ============================================================================
#  Uso:  p3/scripts/run_cluster.sh --rehearsal
#
#  No sustituye a la ejecucion real en 3 PCs: solo comprueba que los scripts,
#  el hostfile, los ejecutables y los barridos funcionan de principio a fin.
# ============================================================================

NODES=(localhost)
SSH_USER="${USER}"
WORKDIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
SLOTS_PER_NODE=8
SYNC_MODE=nfs
USE_SSH=0
MPI_FLAGS="--oversubscribe"
MAP_BY=slot
BIND_TO=none
NET_IFACE=""
RESULTS_DIR="${WORKDIR}/p3/results/cluster_rehearsal"
